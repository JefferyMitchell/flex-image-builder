{
  "variables":
  {
    "client_id": "",
    "client_secret": "",
    "client_object_id": "",
    "client_tenant_id": "",
    "client_subscription_id": "",
    "use_azure_cli_auth": "true",

    "image_resource_group": "",
    "optimizer_template": "",

    "managed_identity_id": "",
    "vda_blob_url": "",
    "optimizer_blob_url": "",
    "vda_location": "C:\\Windows\\Temp\\VDASetup.exe",
    "optimizer_location": "C:\\Windows\\Temp\\CitrixOptimizer.zip",

    "image_name": "win_desktop_11_23h2",
    "gallery_image_version": "1.0.0",
    "gallery_name": "FlexPackerGallery",
    "gallery_image_name": "WinDesktop11Enterprise23H2",
    "location": "East US",
    "location_setup": "c:\\setup",

    "install_browser_chrome_flag": "true",
    "install_browser_firefox_flag": "true",

    "script_installvda":     "install-vda.ps1",
    "script_optimizer":      "run-optimizer.ps1",
    "script_installchrome":  "install-browser-chrome.ps1",
    "script_installfirefox": "install-browser-firefox.ps1",
    "script_cleanup":        "run-cleanup.ps1",

    "allowed_inbound_ip": "",
    "virtual_network_name": "",
    "virtual_network_subnet_name": "",
    "virtual_network_resource_group_name": "",

    "username": "packer",
    "userpass": "",
    "winrm_insecure": "true"
  },
  "builders": [{
    "type": "azure-arm",

    "client_id":       "{{user `client_id`}}",
    "client_secret":   "{{user `client_secret`}}",
    "tenant_id":       "{{user `client_tenant_id`}}",
    "subscription_id": "{{user `client_subscription_id`}}",
    "object_id":       "{{user `client_object_id`}}",
    "use_azure_cli_auth": "{{user `use_azure_cli_auth`}}",

    "shared_image_gallery_destination": {
      "subscription":        "{{user `client_subscription_id`}}",
      "resource_group":      "{{user `image_resource_group`}}",
      "gallery_name":        "{{user `gallery_name`}}",
      "image_name":          "{{user `gallery_image_name`}}",
      "image_version":       "{{user `gallery_image_version`}}",
      "replication_regions": ["{{user `location`}}"],
      "specialized":         true
    },

    "os_type":          "Windows",
    "image_publisher":  "MicrosoftWindowsDesktop",
    "image_offer":      "windows-11",
    "image_sku":        "win11-23h2-ent",
    "image_version":    "latest",
    "security_type":    "TrustedLaunch",

    "communicator":    "winrm",
    "winrm_use_ssl":   true,
    "winrm_insecure":  "{{user `winrm_insecure`}}",
    "winrm_timeout":   "20m",
    "winrm_username":  "{{user `username`}}",
    "winrm_password":  "{{user `userpass`}}",

    "user_assigned_managed_identities": ["{{user `managed_identity_id`}}"],

    "allowed_inbound_ip_addresses": ["{{user `allowed_inbound_ip`}}"],
    "virtual_network_name": "{{user `virtual_network_name`}}",
    "virtual_network_subnet_name": "{{user `virtual_network_subnet_name`}}",
    "virtual_network_resource_group_name": "{{user `virtual_network_resource_group_name`}}",

    "azure_tags": {
      "Image": "Packer Generated"
    },

    "build_resource_group_name": "{{user `image_resource_group`}}",
    "vm_size":  "Standard_D2s_v3"
  }],
  "provisioners": [
    {
      "type": "powershell",
      "inline": [
        "New-Item -Path {{user `location_setup`}} -ItemType \"directory\" | Out-Null"
      ]
    },
    {
      "type": "file",
      "source":      "./{{user `script_installvda`}}",
      "destination": "{{user `location_setup`}}\\{{user `script_installvda`}}"
    },
    {
      "type": "file",
      "source":      "../scripts/{{user `script_optimizer`}}",
      "destination": "{{user `location_setup`}}\\{{user `script_optimizer`}}"
    },
    {
      "type": "file",
      "source":      "../scripts/{{user `script_installchrome`}}",
      "destination": "{{user `location_setup`}}\\{{user `script_installchrome`}}"
    },
    {
      "type": "file",
      "source":      "../scripts/{{user `script_installfirefox`}}",
      "destination": "{{user `location_setup`}}\\{{user `script_installfirefox`}}"
    },
    {
      "type": "file",
      "source":      "../scripts/{{user `script_cleanup`}}",
      "destination": "{{user `location_setup`}}\\{{user `script_cleanup`}}"
    },
    {
      "type": "powershell",
      "inline": [
        "$token = (Invoke-RestMethod -Uri 'http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https://storage.azure.com/' -Headers @{Metadata='true'}).access_token",
        "$hdrs = @{ Authorization = \"Bearer $token\"; 'x-ms-version' = '2020-04-08' }",
        "Write-Host 'Downloading VDA installer via managed identity...'",
        "Invoke-WebRequest -Uri '{{user `vda_blob_url`}}' -Headers $hdrs -OutFile '{{user `vda_location`}}' -UseBasicParsing",
        "Write-Host 'Downloading Citrix Optimizer via managed identity...'",
        "Invoke-WebRequest -Uri '{{user `optimizer_blob_url`}}' -Headers $hdrs -OutFile '{{user `optimizer_location`}}' -UseBasicParsing",
        "Add-Type -AssemblyName System.IO.Compression.FileSystem",
        "$zip = [System.IO.Compression.ZipFile]::OpenRead('{{user `optimizer_location`}}')",
        "$templates = @($zip.Entries | Where-Object { $_.FullName -match '^Templates[\\\\/][^\\\\/]+\\.xml$' } | ForEach-Object { $_.Name })",
        "$zip.Dispose()",
        "if ($templates -notcontains '{{user `optimizer_template`}}') { Write-Error \"optimizer_template '{{user `optimizer_template`}}' is not in the Citrix Optimizer zip, so the image would not be optimized. Templates in this zip: $($templates -join ', ')\"; exit 1 }",
        "Write-Host 'Optimizer template found: {{user `optimizer_template`}}'",
        "Write-Host 'Downloads complete.'"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "{{user `location_setup`}}\\{{user `script_installvda`}} -VdaSetupDownloadUri '{{user `vda_location`}}'"
      ]
    },
    {
      "type": "windows-restart",
      "restart_check_command": "powershell -command \"& {Write-Host 'Script: computer restarted.'}\"",
      "restart_timeout": "30m"
    },
    {
      "type": "powershell",
      "inline": [
        "{{user `location_setup`}}\\{{user `script_installvda`}} -VdaSetupDownloadUri '{{user `vda_location`}}'"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "$ngen64 = \"C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\ngen.exe\"",
        "$ngen32 = \"C:\\Windows\\Microsoft.NET\\Framework\\v4.0.30319\\ngen.exe\"",
        "Write-Host \"Running 64-bit Ngen...\"",
        "& $ngen64 executequeueditems",
        "Write-Host \"Running 32-bit Ngen...\"",
        "& $ngen32 executequeueditems"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "{{user `location_setup`}}\\{{user `script_optimizer`}} -OptimizerDownloadUri '{{user `optimizer_location`}}' -Template {{user `optimizer_template`}}"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "{{user `location_setup`}}\\{{user `script_installchrome`}} -InstallSoftware {{user `install_browser_chrome_flag`}}"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "{{user `location_setup`}}\\{{user `script_installfirefox`}} -InstallSoftware {{user `install_browser_firefox_flag`}}"
      ]
    },
    {
      "type": "powershell",
      "inline": [
        "{{user `location_setup`}}\\{{user `script_cleanup`}} -Username {{user `username`}} -LocationPath {{user `location_setup`}}"
      ]
    }
  ]
}
