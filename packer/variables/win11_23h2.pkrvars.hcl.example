# Packer variables for Windows 11 23H2 + VDA 2507
# Copy to win11_23h2.pkrvars.hcl and fill in values.
# NEVER commit the filled-in file — it contains secrets.

# ── Azure service principal ────────────────────────────────────────────────────
client_id              = ""
client_secret          = ""
client_object_id       = ""
client_tenant_id       = ""
client_subscription_id = ""

# ── Build target ───────────────────────────────────────────────────────────────
image_resource_group = "rg-flex-packer-build"
image_name           = "win_desktop_11_23h2"

# ── Installer locations ────────────────────────────────────────────────────────
vda_location       = "https://<storage-account>.blob.core.windows.net/<container>/VDASetup.exe?<sas-token>"
optimizer_location = "https://<storage-account>.blob.core.windows.net/<container>/CitrixOptimizer.zip?<sas-token>"
optimizer_template = "Citrix_Windows_11_2009.xml"

# ── Build VM credentials ───────────────────────────────────────────────────────
userpass       = ""
winrm_insecure = true

# ── Optional ───────────────────────────────────────────────────────────────────
install_browser_chrome_flag  = true
install_browser_firefox_flag = false
location_setup               = "c:\\setup"