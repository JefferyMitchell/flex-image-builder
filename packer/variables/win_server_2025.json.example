{
  "client_id":              "<service principal appId, from 00-setup-azure.ps1>",
  "client_secret":          "<service principal secret, from 00-setup-azure.ps1; never commit>",
  "client_object_id":       "<service principal object ID, from 00-setup-azure.ps1>",
  "client_tenant_id":       "<Entra tenant ID>",
  "client_subscription_id": "<subscription that holds the build resource group and gallery>",

  "image_resource_group":   "rg-flex-packer-build",
  "image_name":             "win_server_2025_dc",
  "gallery_image_version":  "1.0.0",

  "managed_identity_id":    "<managed_identity_id, from 00-setup-azure.ps1>",
  "vda_blob_url":           "https://<storage-account>.blob.core.windows.net/installers/VDASetup.exe",
  "optimizer_blob_url":     "https://<storage-account>.blob.core.windows.net/installers/CitrixOptimizer.zip",
  "optimizer_template":     "Citrix_Windows_Server_2025.xml",

  "userpass":               "<temporary WinRM password for the build VM>",
  "winrm_insecure":         "true",

  "install_browser_chrome_flag":  "true",
  "install_browser_firefox_flag": "false"
}
